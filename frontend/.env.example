# URL base del backend, sin /api al final (el apiClient la antepone a cada ruta).
# En desarrollo el backend corre en el puerto 4000. Copiá este archivo a .env.
VITE_API_URL=http://localhost:4000

# Simula con MSW las rutas que el backend todavía no tiene (cursos e
# inscripciones). Solo funciona con npm run dev; login y registro siguen yendo
# al backend real. Ver src/mocks/handlers.ts.
VITE_MOCKS=false

# ID de medición de Google Analytics 4. Es público: va dentro del front.
# Si queda vacío, la app funciona, pero no envía eventos.
VITE_GA_ID=